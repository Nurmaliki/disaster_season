# ---------------------------------------------------------------------------
# Indonesia Disaster & Season Monitor — environment configuration
#
# Copy this file to `.env` and adjust as needed. Every value below is OPTIONAL:
# the application ships with the official Indonesian endpoints as defaults and
# runs without any environment configuration at all.
#
# SECURITY: nothing in this file is prefixed PUBLIC_, so nothing here is bundled
# into the browser. Only `PUBLIC_*` variables are exposed to the client, and no
# secret may ever be given a PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Provider endpoints -----------------------------------------------------
# Official Indonesian sources. Override only to point at a mirror/proxy.
BMKG_BASE_URL=https://data.bmkg.go.id
BMKG_API_BASE_URL=https://api.bmkg.go.id
PVMBG_BASE_URL=https://magma.esdm.go.id
BNPB_BASE_URL=https://bnpb.go.id
INARISK_BASE_URL=https://inarisk.bnpb.go.id

# --- Provider timeouts (ms) -------------------------------------------------
# MAGMA is slow to respond on cold cache; keep a generous budget.
BMKG_TIMEOUT_MS=12000
PVMBG_TIMEOUT_MS=25000
BNPB_TIMEOUT_MS=10000
INARISK_TIMEOUT_MS=10000
GLOBAL_TIMEOUT_MS=30000

# --- Cache TTLs (seconds) ---------------------------------------------------
# How long a fetched payload is considered fresh.
CACHE_TTL_WEATHER=900
CACHE_TTL_EARTHQUAKE=120
CACHE_TTL_WARNING=300
CACHE_TTL_VOLCANO=1800
CACHE_TTL_DISASTER=900
CACHE_TTL_SEASON=21600
CACHE_TTL_HAZARD=86400
CACHE_TTL_REGIONS=604800
CACHE_TTL_DASHBOARD=120
CACHE_TTL_STATUS=60

# --- Stale TTLs (seconds) ---------------------------------------------------
# How long an EXPIRED entry may still be served when the provider is failing.
# This is a resilience measure, not a freshness guarantee: the UI always marks
# data served this way as stale.
STALE_TTL_WEATHER=7200
STALE_TTL_EARTHQUAKE=3600
STALE_TTL_WARNING=3600
STALE_TTL_VOLCANO=86400
STALE_TTL_DISASTER=86400
STALE_TTL_SEASON=604800
STALE_TTL_HAZARD=604800

# --- Rate limiting ----------------------------------------------------------
# Sliding-window limit protecting upstream providers and this function.
# NOTE: this is per-instance; on serverless it is a best-effort guardrail.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Logging ----------------------------------------------------------------
# One of: debug | info | warn | error
LOG_LEVEL=info

# --- Optional durable storage (PostgreSQL) ----------------------------------
# The app runs FULLY STATELESS by default. Leave DATABASE_URL unset and the
# in-process event store is used; nothing else changes except that disaster
# history is lost on restart/redeploy.
#
# Set DATABASE_URL to persist events for long-window statistics. This is never
# required for the app to function, and a database outage degrades gracefully
# back to stateless mode (it can never crash a request).
#
# SECURITY: DATABASE_URL is a credential. It is NOT prefixed PUBLIC_ and is
# never sent to the browser.
#
# DATABASE_URL=postgres://user:password@localhost:5432/disaster_monitor
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_MS=10000
# Events older than this are pruned opportunistically after a sync.
DATABASE_RETENTION_DAYS=90

# --- Maintenance / retention cron -------------------------------------------
# Protects GET /api/maintenance/retention, which prunes events past the
# retention window. Vercel Cron sends this automatically as
# `Authorization: Bearer <CRON_SECRET>` when the variable is set on the project.
#
# SECURITY: when CRON_SECRET is UNSET the endpoint refuses to run entirely
# (HTTP 503). An unauthenticated destructive route is worse than no pruning.
# Generate one with:  openssl rand -hex 32
# CRON_SECRET=

# --- Public map configuration (SAFE TO EXPOSE — no secrets) -----------------
# Basemap style URLs. Must be publicly accessible and contain no API keys.
# Default (when unset) is OpenFreeMap, which needs no key and is not commonly
# blocked by ad/privacy browser extensions. A blocked basemap shows a blank map
# while the rest of the UI works, so prefer a provider your users can reach.
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
